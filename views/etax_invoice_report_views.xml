<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- e-Tax Invoices List View -->
    <record id="view_etax_invoice_tree" model="ir.ui.view">
        <field name="name">account.move.etax.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="e-Tax Invoices" 
                  decoration-info="move_type == 'out_invoice' and not etax_finalized"
                  decoration-warning="move_type == 'out_refund' and not etax_finalized"
                  decoration-success="etax_finalized == True"
                  decoration-muted="etax_exported == True and etax_finalized == False"
                  default_order="invoice_date desc, name desc"
                  multi_edit="1">
                <header>
                    <button name="%(action_etax_excel_export_wizard)d" 
                            string="Export to Excel" 
                            type="action"
                            class="oe_highlight"/>
                    <button name="action_mark_etax_finalized" 
                            string="Finalize Selected" 
                            type="object"
                            class="btn-warning"
                            confirm="Are you sure you want to finalize the selected invoices? They will no longer be editable."/>
                </header>
                <field name="name" string="Invoice Number"/>
                <field name="move_type" string="Type" 
                       decoration-info="move_type == 'out_invoice'"
                       decoration-warning="move_type == 'out_refund'"
                       widget="badge"/>
                <field name="invoice_date" string="Invoice Date"/>
                <field name="invoice_date_due" string="Due Date" optional="show"/>
                <field name="partner_id" string="Customer"/>
                <field name="amount_untaxed" string="Untaxed" sum="Total Untaxed"/>
                <field name="amount_tax" string="Tax" sum="Total Tax"/>
                <field name="amount_total" string="Total" sum="Grand Total"/>
                <field name="currency_id" optional="hide"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'posted'"
                       decoration-info="state == 'draft'"/>
                <field name="etax_exported" string="Exported" widget="boolean"/>
                <field name="etax_finalized" string="Finalized" widget="boolean"/>
                <field name="etax_export_date" string="Export Date" optional="show"/>
                <field name="etax_finalized_date" string="Finalized Date" optional="hide"/>
                <field name="etax_export_batch" string="Batch" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- e-Tax Invoices Search View -->
    <record id="view_etax_invoice_search" model="ir.ui.view">
        <field name="name">account.move.etax.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="e-Tax Invoices">
                <field name="name" string="Invoice Number"/>
                <field name="partner_id" string="Customer"/>
                <field name="invoice_date"/>
                <field name="ref" string="Reference"/>
                <field name="etax_export_batch" string="Export Batch"/>
                <separator/>
                <filter string="Invoices" name="invoices" 
                        domain="[('move_type', '=', 'out_invoice')]"/>
                <filter string="Credit Notes" name="credit_notes" 
                        domain="[('move_type', '=', 'out_refund')]"/>
                <separator/>
                <filter string="Not Exported" name="not_exported" 
                        domain="[('etax_exported', '=', False)]"/>
                <filter string="Exported" name="exported" 
                        domain="[('etax_exported', '=', True)]"/>
                <separator/>
                <filter string="Not Finalized" name="not_finalized" 
                        domain="[('etax_finalized', '=', False)]"/>
                <filter string="Finalized" name="finalized" 
                        domain="[('etax_finalized', '=', True)]"/>
                <separator/>
                <filter string="Invoice Date" name="filter_invoice_date" date="invoice_date"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="groupby_customer" 
                            domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter string="Invoice Date" name="groupby_date" 
                            domain="[]" context="{'group_by': 'invoice_date'}"/>
                    <filter string="Type" name="groupby_type" 
                            domain="[]" context="{'group_by': 'move_type'}"/>
                    <filter string="Export Status" name="groupby_exported" 
                            domain="[]" context="{'group_by': 'etax_exported'}"/>
                    <filter string="Finalized Status" name="groupby_finalized" 
                            domain="[]" context="{'group_by': 'etax_finalized'}"/>
                    <filter string="Export Batch" name="groupby_batch" 
                            domain="[]" context="{'group_by': 'etax_export_batch'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- e-Tax Invoices Action -->
    <record id="action_etax_invoices" model="ir.actions.act_window">
        <field name="name">e-Tax Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_etax_invoice_tree"/>
        <field name="search_view_id" ref="view_etax_invoice_search"/>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('state', '=', 'posted')]</field>
        <field name="context">{
            'default_move_type': 'out_invoice',
            'search_default_not_finalized': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No invoices to export for e-Tax
            </p>
            <p>
                This view shows all posted customer invoices and credit notes 
                that can be exported for Thailand e-Tax processing.
            </p>
            <p>
                <strong>Workflow:</strong>
                <ol>
                    <li>Select invoices and click "Export to Excel"</li>
                    <li>Download the Excel file and process in your e-Tax system</li>
                    <li>Once submitted to Revenue Department, finalize the invoices</li>
                </ol>
            </p>
        </field>
    </record>

</odoo>
