<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Invoice Form View -->
    <record id="view_move_form_inherit_etax" model="ir.ui.view">
        <field name="name">account.move.form.inherit.etax</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add e-Tax buttons to header -->
            <xpath expr="//header" position="inside">
                <button name="action_export_etax_xml" 
                        string="Export e-Tax XML" 
                        type="object" 
                        class="oe_highlight"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund') or etax_status in ('exported', 'signed', 'validated')"
                        groups="account.group_account_user"/>
                <button name="action_download_etax_xml" 
                        string="Download XML" 
                        type="object"
                        invisible="not etax_xml_file"
                        groups="account.group_account_user"/>
                <button name="action_reset_etax" 
                        string="Reset e-Tax" 
                        type="object"
                        invisible="etax_status == 'draft'"
                        groups="account.group_account_manager"
                        confirm="Are you sure you want to reset e-Tax export status?"/>
                <field name="etax_status" widget="badge" 
                       decoration-success="etax_status in ('exported', 'signed', 'validated')"
                       decoration-danger="etax_status == 'error'"
                       decoration-info="etax_status == 'draft'"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
            
            <!-- Add e-Tax tab -->
            <xpath expr="//notebook" position="inside">
                <page string="e-Tax" name="etax" invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <group string="Export Information">
                            <field name="etax_document_id"/>
                            <field name="etax_export_date"/>
                            <field name="etax_signature_date"/>
                            <field name="etax_is_exported"/>
                        </group>
                        <group string="File Information">
                            <field name="etax_xml_filename"/>
                            <field name="etax_xml_file" filename="etax_xml_filename" invisible="not etax_xml_file"/>
                        </group>
                    </group>
                    <group invisible="not etax_error_message">
                        <group string="Error Details">
                            <field name="etax_error_message" colspan="2" nolabel="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Inherit Invoice Tree View -->
    <record id="view_invoice_tree_inherit_etax" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.etax</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="multi_edit">1</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="etax_status" optional="show" 
                       widget="badge"
                       decoration-success="etax_status in ('exported', 'signed', 'validated')"
                       decoration-danger="etax_status == 'error'"/>
                <field name="etax_is_exported" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Action: Batch Export e-Tax -->
    <record id="action_etax_batch_export" model="ir.actions.act_window">
        <field name="name">Batch Export e-Tax</field>
        <field name="res_model">etax.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
    </record>

    <!-- Menu Item for e-Tax Export -->
    <menuitem id="menu_etax_export"
              name="Export e-Tax"
              parent="thailand_etax.menu_etax_root"
              sequence="20"/>
</odoo>
