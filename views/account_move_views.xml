<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Add e-Tax fields to Invoice form -->
    <record id="view_move_form_etax" model="ir.ui.view">
        <field name="name">account.move.form.etax</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            
            <!-- Add e-Tax tab after other tabs -->
            <xpath expr="//notebook" position="inside">
                <page string="e-Tax" name="etax" groups="account.group_account_invoice">
                    
                    <group>
                        <group string="Export Status">
                            <field name="etax_exported" readonly="1"/>
                            <field name="etax_export_date" readonly="1" attrs="{'invisible': [('etax_exported', '=', False)]}"/>
                            <field name="etax_export_batch" readonly="1" attrs="{'invisible': [('etax_exported', '=', False)]}"/>
                        </group>
                        
                        <group string="Finalization Status">
                            <field name="etax_finalized" readonly="1"/>
                            <field name="etax_finalized_date" readonly="1" attrs="{'invisible': [('etax_finalized', '=', False)]}"/>
                            <field name="etax_finalized_by" readonly="1" attrs="{'invisible': [('etax_finalized', '=', False)]}"/>
                        </group>
                    </group>
                    
                    <div class="alert alert-info" role="alert" style="margin-top: 20px;">
                        <h4>e-Tax Export Information</h4>
                        <ul>
                            <li><strong>Exported:</strong> Invoice has been exported to Excel for e-Tax processing</li>
                            <li><strong>Finalized:</strong> Invoice is locked and cannot be modified (submitted for e-Tax)</li>
                        </ul>
                        <p><em>Note: Reference documents for credit notes and withholding tax are automatically retrieved from invoice data during export.</em></p>
                    </div>
                    
                </page>
            </xpath>
            
        </field>
    </record>
    
    <!-- Add e-Tax fields to Invoice tree view -->
    <record id="view_invoice_tree_etax" model="ir.ui.view">
        <field name="name">account.move.tree.etax</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-info">etax_exported == True and etax_finalized == False</attribute>
                <attribute name="decoration-success">etax_finalized == True</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="etax_exported" optional="show"/>
                <field name="etax_finalized" optional="show"/>
            </xpath>
        </field>
    </record>
    
    <!-- Add search filters for e-Tax -->
    <record id="view_account_invoice_filter_etax" model="ir.ui.view">
        <field name="name">account.invoice.select.etax</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='late']" position="after">
                <separator/>
                <filter string="Exported to e-Tax" name="etax_exported" 
                        domain="[('etax_exported', '=', True)]"/>
                <filter string="Not Exported to e-Tax" name="not_etax_exported" 
                        domain="[('etax_exported', '=', False)]"/>
                <filter string="e-Tax Finalized" name="etax_finalized" 
                        domain="[('etax_finalized', '=', True)]"/>
                <filter string="Not e-Tax Finalized" name="not_etax_finalized" 
                        domain="[('etax_finalized', '=', False)]"/>
            </xpath>
        </field>
    </record>
    
</odoo>
