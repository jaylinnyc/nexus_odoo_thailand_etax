<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- e-Tax Configuration Tree View -->
    <record id="view_etax_config_tree" model="ir.ui.view">
        <field name="name">etax.config.tree</field>
        <field name="model">etax.config</field>
        <field name="arch" type="xml">
            <tree string="e-Tax Configuration">
                <field name="company_id"/>
                <field name="signing_service_url"/>
                <field name="auto_sign"/>
                <field name="auto_submit_to_rd"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- e-Tax Configuration Form View -->
    <record id="view_etax_config_form" model="ir.ui.view">
        <field name="name">etax.config.form</field>
        <field name="model">etax.config</field>
        <field name="arch" type="xml">
            <form string="e-Tax Configuration">
                <header>
                    <button name="action_test_connection" string="Test Connection" type="object" class="oe_highlight"/>
                    <button name="action_test_certificate" string="Check Certificate" type="object"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    </div>
                    <group>
                        <group string="Company">
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Signing Service" name="signing_service">
                            <group>
                                <group string="Connection Settings">
                                    <field name="signing_service_url" placeholder="http://localhost:8443"/>
                                    <field name="signing_api_key" password="True"/>
                                    <field name="callback_url" readonly="1"/>
                                </group>
                                <group string="Automation">
                                    <field name="auto_sign"/>
                                    <field name="auto_submit_to_rd"/>
                                </group>
                            </group>
                            <group>
                                <div class="alert alert-info" role="alert">
                                    <h4 class="alert-heading">About Signing Service</h4>
                                    <p>
                                        The signing service is an on-premise application that handles digital signatures 
                                        using your USB certificate token. It must be running on a server with the USB 
                                        token physically connected.
                                    </p>
                                    <hr/>
                                    <p class="mb-0">
                                        <strong>Setup:</strong> Deploy the <code>thailand-etax-signing-service</code> 
                                        Docker container on your local server with the USB token attached.
                                    </p>
                                </div>
                            </group>
                        </page>
                        
                        <page string="Output Settings" name="output">
                            <group>
                                <group>
                                    <field name="output_directory"/>
                                    <field name="validate_xml"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- e-Tax Configuration Action -->
    <record id="action_etax_config" model="ir.actions.act_window">
        <field name="name">e-Tax Configuration</field>
        <field name="res_model">etax.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure e-Tax Settings
            </p>
            <p>
                Set up connection to your on-premise signing service for Thailand e-Tax.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_etax_root"
              name="e-Tax"
              parent="account.menu_finance_configuration"
              sequence="100"/>
    
    <menuitem id="menu_etax_config"
              name="e-Tax Settings"
              parent="menu_etax_root"
              action="action_etax_config"
              sequence="10"/>
</odoo>
